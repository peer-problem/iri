# Generate separate keys locally. Never paste secrets into chat or Git.
SANDBOX_API_KEY=
MODEL_API_KEY=
MODEL_BASE_URL=http://127.0.0.1:8001/v1
MODEL_PROFILE=kanana
# Full Hugging Face commit SHA. Filled after resolving the model revision.
MODEL_REVISION=
REQUEST_TIMEOUT_SECONDS=90
MAX_WAITING=5
# Optional. Only needed when testing actual OpenAI transcription.
OPENAI_API_KEY=
STT_MODEL=gpt-transcribe
STT_TIMEOUT_SECONDS=60
STT_MAX_BYTES=10485760
# Local management only. Never copy the account-wide Runpod key to a Pod.
RUNPOD_API_KEY=
HF_TOKEN=
