[Unit]
Description=IRI voice conversation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iri
Group=iri
WorkingDirectory=/opt/iri/current
EnvironmentFile=/opt/iri/shared/api.env
ExecStart=/opt/iri/venv/bin/uvicorn api.app.app:app --host 127.0.0.1 --port 8300 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/iri
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
